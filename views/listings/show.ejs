<% layout("/layouts/boilerplate")%>
<body>
    
    
 <div class="card  listing-card offset-3 mt-3"  style="width: 35rem">
<h4><%= listing.title %>  </h4>  
         <img src="<%=listing.image.url%>" class="card-img-top"  alt="Listing Image">
   <div class="card-body">
        <h5 class="card-title"></h5>
    
         <p  class="card-text">Owned by <i><%=listing.owner.username %></i></p>
         <p class="card-text"><i><%= listing.description %></i> </p>
         <p class="card-text">₹<%= listing.price.toLocaleString("en-IN")%> </p>
         <p class="card-text"><%= listing.location %> </p>
         <p class="card-text"><%= listing.country %> </p><br>
     
    
  </div>
 
 
    <div class="row">

      <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
  <div class="card-body btns mb-3">
    <a class="btn btn-dark add-btn offset-0.5" href="/listing/<%=listing._id%>/edit">Edit this listing !</a>
        <form method="POST" action="/listing/<%= listing._id%>?_method=DELETE">
            <button class="btn btn-dark offset-2">Delete</button>
        </form>
  </div>
     <% } %>

  </div>


  

 <hr>

<div class="container mt-4">

  <% if (currUser) { %>
    <h4>Leave a Review!</h4>

    <form novalidate
          class="needs-validation mb-4"
          method="POST"
          action="/listing/<%= listing._id %>/reviews">

      <label class="form-label">Rating</label>

      <fieldset class="starability-slot mb-3" style="width:35rem">
        <input type="radio" class="input-no-rate" name="review[rating]" value="" checked>

        <input type="radio" id="rate1" name="review[rating]" value="1">
        <label for="rate1">1 star</label>

        <input type="radio" id="rate2" name="review[rating]" value="2">
        <label for="rate2">2 stars</label>

        <input type="radio" id="rate3" name="review[rating]" value="3">
        <label for="rate3">3 stars</label>

        <input type="radio" id="rate4" name="review[rating]" value="4">
        <label for="rate4">4 stars</label>

        <input type="radio" id="rate5" name="review[rating]" value="5">
        <label for="rate5">5 stars</label>
      </fieldset>

      <div class="mb-3">
        <label class="form-label">Comment</label>
        <textarea name="review[comment]"
                  rows="4"
                  class="form-control"
                  required></textarea>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr>
  <% } %>

  <!-- REVIEWS ALWAYS VISIBLE -->

  <% if(listing.reviews.length > 0) { %>
  

  <div class="row g-3">
    <h4>All Reviews</h4>
    <% for (let review of listing.reviews) { %>

      <div class="col-md-6 mb-3">
        <div class="card h-100">
          <div class="card-body mb-3 mt-3 ms-3">
            <h5><b>@<%= review.author.username %></b></h5>

            <p class="starability-result"
               data-rating="<%= review.rating %>"></p>

            <p><%= review.comment %></p>

            <% if (currUser && review.author._id.equals(currUser._id)) { %>
              <form method="POST"
                    action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            <% } %>

          </div>
        </div>
      </div>

    <% } %>
  </div>
  <% } %>
  

  <!-- yeh error sirf dikh rahe baki run time pr effect nhi karenge  -->
   <!-- avoid karo -->
    
  <h4>Where you'll be</h4>
  <div class="mb-3"  id="map" style="height: 400px; width: 100%;" ></div>

 <script>
document.addEventListener("DOMContentLoaded", function () {
  // Safely get coordinates using JSON.stringify
  const lat = <%= JSON.stringify(listing.latitude || null) %>;
  const lon = <%= JSON.stringify(listing.longitude || null) %>;

  if (lat !== null && lon !== null) {
    // Initialize the map
    const map = L.map('map').setView([lat, lon], 13);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Marker with popup
    const popupText = <%- JSON.stringify(listing.title || "No title") %>;
    L.marker([lat, lon])
      .addTo(map)
      .bindPopup(popupText)
      .openPopup();
  } else {
    document.getElementById('map').innerHTML = "Location not found";
  }
});
</script>










</div>


  </div>
</div>

    
</body>
